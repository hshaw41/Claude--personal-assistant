# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OPTIONAL: Anthropic API key (https://console.anthropic.com/)
# Leave blank if you're using a Claude Pro/Max subscription — run `claude login`
# once on the VPS as the assistant user instead.
ANTHROPIC_API_KEY=

# Comma-separated Telegram user IDs allowed to DM the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=

# Owner chat ID for error DMs and deploy notifications (usually same as your user ID)
OWNER_CHAT_ID=

# Optional: log level (trace|debug|info|warn|error)
LOG_LEVEL=info
